<!--
    Custom changelog. Picked up automatically by the `db/custom-changelog` includeAll in
    db.changelog-master.xml (context: custom_changelog), so it never touches the core sequential
    `parts/` series and won't conflict on upstream pulls. Preconditions make it idempotent.

    Registers a per-loan-product config datatable selecting the FORECLOSURE INTEREST method
    (foreclosure_interest_method, e.g. STANDARD | FLAT_ON_OUTSTANDING). Editable via Fineract's
    datatable API/UI; read by ForeclosureInterestResolver at foreclosure time. Day-in-year/month
    are NOT stored here; they come from the product's own daysInYearType / daysInMonthType.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet author="fineract" id="loan_product_foreclosure_config-1-create-table">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="loan_product_foreclosure_config"/>
            </not>
        </preConditions>
        <createTable tableName="loan_product_foreclosure_config">
            <column name="product_loan_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="foreclosure_interest_method" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="loan_product_foreclosure_config" baseColumnNames="product_loan_id"
                                 constraintName="fk_loan_product_foreclosure_config_product_loan_id"
                                 referencedTableName="m_product_loan" referencedColumnNames="id"/>
    </changeSet>

    <changeSet author="fineract" id="loan_product_foreclosure_config-2-register">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM x_registered_table WHERE registered_table_name =
                'loan_product_foreclosure_config'</sqlCheck>
        </preConditions>
        <insert tableName="x_registered_table">
            <column name="registered_table_name" value="loan_product_foreclosure_config"/>
            <column name="application_table_name" value="m_product_loan"/>
            <column name="category" valueNumeric="100"/>
        </insert>
    </changeSet>

    <!-- Datatable CRUD permissions (grouping 'datatable'), matching what Fineract's datatable-registration
         API creates. Needed so non-super-admin roles can be granted access; without these only ALL_FUNCTIONS
         roles see the datatable in the web-app (which gates on READ_<table>). -->
    <changeSet author="fineract" id="loan_product_foreclosure_config-3-permissions">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM m_permission WHERE code =
                'READ_loan_product_foreclosure_config'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="datatable"/>
            <column name="code" value="CREATE_loan_product_foreclosure_config"/>
            <column name="action_name" value="CREATE"/>
            <column name="entity_name" value="loan_product_foreclosure_config"/>
            <column name="can_maker_checker" valueNumeric="1"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="datatable"/>
            <column name="code" value="CREATE_loan_product_foreclosure_config_CHECKER"/>
            <column name="action_name" value="CREATE"/>
            <column name="entity_name" value="loan_product_foreclosure_config"/>
            <column name="can_maker_checker" valueNumeric="0"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="datatable"/>
            <column name="code" value="READ_loan_product_foreclosure_config"/>
            <column name="action_name" value="READ"/>
            <column name="entity_name" value="loan_product_foreclosure_config"/>
            <column name="can_maker_checker" valueNumeric="0"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="datatable"/>
            <column name="code" value="UPDATE_loan_product_foreclosure_config"/>
            <column name="action_name" value="UPDATE"/>
            <column name="entity_name" value="loan_product_foreclosure_config"/>
            <column name="can_maker_checker" valueNumeric="1"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="datatable"/>
            <column name="code" value="UPDATE_loan_product_foreclosure_config_CHECKER"/>
            <column name="action_name" value="UPDATE"/>
            <column name="entity_name" value="loan_product_foreclosure_config"/>
            <column name="can_maker_checker" valueNumeric="0"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="datatable"/>
            <column name="code" value="DELETE_loan_product_foreclosure_config"/>
            <column name="action_name" value="DELETE"/>
            <column name="entity_name" value="loan_product_foreclosure_config"/>
            <column name="can_maker_checker" valueNumeric="1"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="datatable"/>
            <column name="code" value="DELETE_loan_product_foreclosure_config_CHECKER"/>
            <column name="action_name" value="DELETE"/>
            <column name="entity_name" value="loan_product_foreclosure_config"/>
            <column name="can_maker_checker" valueNumeric="0"/>
        </insert>
    </changeSet>

</databaseChangeLog>
